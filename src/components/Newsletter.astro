---
---
<section class="newsletter wrap" aria-labelledby="nl-h">
  <div data-m="g2" class="nl-card">
    <div class="nl-copy">
      <span class="eyebrow nl-eyebrow">KIVRIM BÜLTENİ</span>
      <h2 id="nl-h">Yeni tarifler ve kampanyalar e-postanızda.</h2>
      <p>Ayda iki kez, yalnızca işinize yarayacak içerikler.</p>
    </div>
    <form class="nl-form" data-kv-form="Bülten aboneliği" data-newsletter novalidate>
      <div class="nl-row">
        <input type="email" name="email" required placeholder="E-posta adresiniz" aria-label="E-posta adresiniz" autocomplete="email" />
        <button type="submit">Abone ol</button>
      </div>
      <label class="nl-consent"><input type="checkbox" name="iys_onay" value="Evet" required />KVKK kapsamında ticari elektronik ileti almayı kabul ediyorum.</label>
      <p class="form-status" role="status" hidden></p>
    </form>
  </div>
</section>
