---
import { Image } from 'astro:assets';
import { photo } from '../lib/images';
interface Props { k: string; alt: string; class?: string; style?: string; loading?: 'lazy' | 'eager'; widths?: number[]; sizes?: string; fetchpriority?: 'high' | 'low' | 'auto' }
const { k, alt, class: cls, style, loading = 'lazy', widths = [480, 800, 1200, 1600], sizes = '100vw', fetchpriority } = Astro.props;
const src = photo(k);
const ws = widths.filter((w) => w <= src.width);
---
<Image src={src} alt={alt} class={cls} style={style} loading={loading} widths={ws.length ? ws : [src.width]} sizes={sizes} format="webp" quality={78} fetchpriority={fetchpriority} />
