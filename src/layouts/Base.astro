---
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/pages.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import Overlays from '../components/Overlays.astro';
import { photo, pack, logo } from '../lib/images';
import { getArticles, getProducts, getRecipes } from '../lib/catalog';
import { ICON_NAMES } from '../lib/icons';
import {
  SITE_URL, EMAIL, ADDRESS, SHOP_ENABLED, DEMO_MODE, FORM_ENDPOINT, FORM_ACCESS_KEY, NEWSLETTER_ENDPOINT,
  FREE_SHIPPING_MIN, SHIPPING_FEE,
} from '../lib/site';

interface Crumb { name: string; href?: string }
interface Props {
  title: string;
  description: string;
  /** Kanonik yol, ör. "/urunler" */
  path?: string;
  noindex?: boolean;
  /** og:image için foto anahtarı (src/assets/foto) */
  ogPhoto?: string;
  ogType?: 'website' | 'article' | 'product';
  jsonLd?: Record<string, unknown>[];
  breadcrumb?: Crumb[];
  /** Sayfa sonundaki bülten bandı */
  newsletter?: boolean;
}
const {
  title, description, path = Astro.url.pathname, noindex = false, ogPhoto = 'hamur-acma', ogType = 'website',
  jsonLd = [], breadcrumb, newsletter = true,
} = Astro.props;

const cleanPath = path === '/' ? '/' : path.replace(/\/$/, '');
const canonical = SITE_URL + (cleanPath === '/' ? '/' : cleanPath);
const og = await getImage({ src: photo(ogPhoto), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, SITE_URL).href;

const ld: Record<string, unknown>[] = [...jsonLd];
if (breadcrumb && breadcrumb.length) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Ana sayfa', href: '/' }, ...breadcrumb].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, ...(c.href ? { item: SITE_URL + (c.href === '/' ? '/' : c.href) } : {}),
    })),
  });
}

// İstemci tarafı (sepet, arama) için küçük katalog
const [products, recipes, articles] = await Promise.all([getProducts(), getRecipes(), getArticles()]);
const packThumbs = Object.fromEntries(await Promise.all(products.map(async (p) => {
  const img = await getImage({ src: pack(p.pack), width: 200, format: 'webp', quality: 80 });
  return [p.id, img.src];
})));
const photoThumb = async (k: string) => (await getImage({ src: photo(k), width: 160, height: 160, fit: 'cover', format: 'webp', quality: 72 })).src;
const clientData = {
  shop: SHOP_ENABLED, demo: DEMO_MODE,
  form: { endpoint: FORM_ENDPOINT, key: FORM_ACCESS_KEY, newsletter: NEWSLETTER_ENDPOINT, email: EMAIL },
  shipping: { freeMin: FREE_SHIPPING_MIN, fee: SHIPPING_FEE },
  products: products.map((p) => ({ id: p.id, name: p.name, price: p.price, tint: p.tint, d: p.description, img: packThumbs[p.id] })),
  recipes: await Promise.all(recipes.map(async (r) => ({
    id: r.id, t: r.title, c: r.category, m: r.minutes + ' dk', p: products.find((x) => x.id === r.product)?.name ?? '', img: await photoThumb(r.image),
  }))),
  articles: articles.map((a) => ({ id: a.id, t: a.data.title, c: a.data.category })),
};
const whiteLogo = await getImage({ src: logo('beyaz'), width: 320, format: 'webp' });

const fontsHref = 'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=JetBrains+Mono:wght@500&display=swap';
const iconsHref = `https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,1,0&icon_names=${[...ICON_NAMES].sort().join(',')}&display=block`;
---
<!doctype html>
<html lang="tr" data-shopoff={SHOP_ENABLED ? undefined : ''}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="tr" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#0B3D1F" />
  <meta property="og:type" content={ogType === 'product' ? 'product' : ogType} />
  <meta property="og:site_name" content="KIVRIM" />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fontsHref} />
  <link rel="stylesheet" href={iconsHref} />
  <script is:inline>
    // Sayfa geçiş perdesi: önceki sayfa perdeyi kapattıysa, yeni sayfada açılış animasyonunu oynat.
    try { if (sessionStorage.getItem('kv-wipe')) { sessionStorage.removeItem('kv-wipe'); document.documentElement.classList.add('kv-wipe-in'); } } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Organization', '@id': SITE_URL + '/#org', name: 'KIVRIM', url: SITE_URL + '/',
    logo: SITE_URL + '/favicon.png', email: EMAIL,
    address: { '@type': 'PostalAddress', streetAddress: ADDRESS.street, addressLocality: ADDRESS.district, addressRegion: ADDRESS.city, addressCountry: 'TR' },
  })} />
  {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
  <slot name="head" />
</head>
<body>
  <a href="#icerik" class="skip-link">İçeriğe geç</a>
  <Header />
  <main id="icerik">
    <slot />
  </main>
  {newsletter && <Newsletter />}
  <Footer />
  <Overlays whiteLogo={whiteLogo.src} />
  <script type="application/json" id="kv-data" set:html={JSON.stringify(clientData)} />
  <script>
    import '../scripts/app';
  </script>
</body>
</html>
