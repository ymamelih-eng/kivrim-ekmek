# Kopyalayın: cp .env.example .env  (Vercel / Cloudflare Pages'te "Environment Variables" olarak girin)

# E-ticaret anahtarı. false: sepet/fiyat/adet gizlenir, "Toptan bilgi al" / "Nereden alırım?" görünür.
PUBLIC_SHOP_ENABLED=false

# Form servisi uç noktası. Boşsa formlar ziyaretçinin e-posta uygulamasını açar (mailto).
#  Web3Forms : PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit  + PUBLIC_FORM_ACCESS_KEY=<anahtar>
#  Formspree : PUBLIC_FORM_ENDPOINT=https://formspree.io/f/<form-id>
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=

# (İsteğe bağlı) Bülten için ayrı uç nokta (Brevo/Mailchimp vb.). Boşsa PUBLIC_FORM_ENDPOINT kullanılır.
PUBLIC_NEWSLETTER_ENDPOINT=

# Yalnızca tasarım önizlemesi: üyelik ve ödeme akışını tarayıcıda simüle eder. Canlıda false.
PUBLIC_DEMO_MODE=false
